# ───────────────────────────────────────────────
# 复制本文件为 .env 后按需修改。.env 不会进版本库。
# ───────────────────────────────────────────────

# 监听地址与端口。局域网使用保持 0.0.0.0
HOST=0.0.0.0
PORT=3000

# 数据目录（SQLite 库文件）与上传目录。相对路径以项目根目录为基准
DATA_DIR=./data
UPLOAD_DIR=./uploads

# 保留期（小时）。房间是一个滚动窗口：超过这个时长的消息连同附件一起删除，
# 文字、代码块、图片一视同仁。到期时间在消息发出那一刻算好，
# 之后把这个值调短只影响新消息，不会让已有历史当场蒸发。
RETENTION_HOURS=12

# 清理任务运行间隔（分钟）
CLEANUP_INTERVAL_MINUTES=10

# 单个文件最大体积（MB）
MAX_UPLOAD_MB=25

# 首屏加载的历史消息条数
HISTORY_LIMIT=80

# 登录会话有效期（天）
SESSION_TTL_DAYS=30

# 是否只在 HTTPS 下发送会话 Cookie。用 https 部署时改为 true
COOKIE_SECURE=false

# ── 账号 ────────────────────────────────────────
# 管理员账号。服务每次启动都会确保这个账号存在，并把密码同步为下面这个值，
# 也就是说 .env 是管理员凭据的唯一事实来源，改完重启即生效。
# 首次启动前必须填 ADMIN_PASSWORD（8~72 字节），否则没有任何账号能登录。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 是否允许任何人自助注册。默认 false：普通用户由管理员登录后在「用户管理」里开号
ALLOW_REGISTRATION=false

# 仅在 ALLOW_REGISTRATION=true 时有意义。留空 = 谁都能注册；填值 = 注册时必须填对邀请码
REGISTRATION_CODE=

# 两次上传之间的最小间隔（毫秒）。挡住热键按住不放连发一串图。
# 0 表示不限制。只对带 API Key 的上传生效：网页端一次拖多张图是正常操作，不该被按秒卡住
UPLOAD_MIN_INTERVAL_MS=1000

# 每分钟允许的上传次数。上面那条防连击，这条防持续刷屏，两者各管各的
UPLOAD_RATE_PER_MINUTE=30

# 同一来源 IP 每分钟允许的登录 / 注册尝试次数，挡在线爆破
LOGIN_RATE_PER_MINUTE=10

# ── 频道专属功能 ────────────────────────────────
# Wardogs 伤害计算器的弹道数据来自 metaforge.app 的公开接口，这里是刷新周期（小时）。
# 拉不到时自动退回仓库自带的快照（server/assets/wardogs）。0 表示不联网，只用快照
WARDOGS_BALLISTICS_REFRESH_HOURS=24
